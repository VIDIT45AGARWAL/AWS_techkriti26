# ──────────────────────────────────────────────
# Example tfvars — Copy to terraform.tfvars
# ──────────────────────────────────────────────

aws_region        = "ap-south-1"
environment       = "dev"
project_name      = "civic-alert"
ec2_instance_type = "t3.medium"
ec2_key_pair_name = "civic-alert-key"  # Create this in AWS Console first
allowed_ssh_cidr  = "0.0.0.0/0"           # Restrict to your IP in production
bedrock_model_id  = "anthropic.claude-3-sonnet-20240229-v1:0"
alert_email       = "vidit.off@gmail.com"                    # Optional: your-email@example.com
